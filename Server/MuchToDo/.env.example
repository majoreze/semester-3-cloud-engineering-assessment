# --- Application ---
PORT=8080

# --- Database ---
# Local development MongoDB connection.
# Replace with your actual connection string.
MONGO_URI=mongodb://localhost:27017
DB_NAME=much_todo_db

# --- Authentication ---
# Generate a unique random secret before running the application.
JWT_SECRET_KEY=replace-with-a-unique-random-secret
JWT_EXPIRATION_HOURS=72

# --- Caching ---
ENABLE_CACHE=false
# ENABLE_CACHE=true
# REDIS_ADDR=localhost:6379
# REDIS_PASSWORD=

# --- Logging ---
# Log level: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=DEBUG

# Log format: json or text
LOG_FORMAT=json

# --- Testing ---
# Set to true to run integration tests.
INTEGRATION=true
